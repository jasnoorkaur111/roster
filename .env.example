# Copy to .env. Everything here can also be set in the app's Settings; .env is just the headless way.

# --- Luma (required) ---
# Your Luma session cookie. luma.com → DevTools → Application → Cookies → https://luma.com → luma.auth-session-key
# Paste the Value. Expires every few weeks; paste a fresh one when the app says "not signed in".
LUMA_COOKIE=

# Your own Luma user id (usr-...), so you are left out of your own guest lists.
# Find it in any guest list the app loads: your row is the one with your name. Optional.
SELF_USER_API_ID=

# --- Claude: pick ONE ---
# Option A (default): your Claude Code login. Nothing to set here. Install Claude Code
# (`npm install -g @anthropic-ai/claude-code`), run `claude` once to sign in, and the app
# shells out to `claude -p`. Usage counts against your Claude plan, not an API key.
#
# Option B: an Anthropic API key, billed per use. Set it and choose "API key" in Settings.
# ANTHROPIC_API_KEY=

# Model used by either option. Default claude-opus-5. claude-sonnet-5 is cheaper.
# MODEL=claude-opus-5

# Port for the local server. Default 4747.
# PORT=4747
